POSTGRES_DB=lechoppe
POSTGRES_USER=lechoppe_user
POSTGRES_PASSWORD=change_this_strong_password
DATABASE_URL=postgresql://lechoppe_user:change_this_strong_password@global-postgres-16:5432/lechoppe
ADMIN_PASSPHRASE=change_this_admin_passphrase
ADMIN_SESSION_SECRET=change_this_independent_session_secret
BOT_CHECK_SECRET=change_this_independent_bot_challenge_secret
# Enable only behind a trusted reverse proxy that overwrites forwarding headers.
TRUST_PROXY_HEADERS=false
NODE_ENV=production
PORT=3000
RESERVATION_TIMEZONE=Europe/Paris
COMPOSE_PROJECT_NAME=lechoppe-postgresql-vps
